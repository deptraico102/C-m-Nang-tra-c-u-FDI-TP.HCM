const MEMBERS=["Đức Hoàng","Quốc Thái","Bảo Như","Cao Duy Gia Bảo","Hà My","Thùy Chi","Yến Ngân","Thanh Khoa","Trường Thi","Ngọc Hân"];

let lang=localStorage.getItem('lang')||'vi', modelIdx=0;
const t=k=>T[lang][k];
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const imgTag=(src,alt,cls='')=>`<img src="${src}" alt="${esc(alt)}" loading="lazy" class="${cls}" onerror="this.style.opacity=0">`;

/* ---------- ÂM THANH CINEMATIC (1 AudioContext dùng chung) ---------- */
let actx=null, masterGain=null, noiseBuf=null, muted=localStorage.getItem('mute')==='1', introPlayed=false, lastHover=0;
const SND={
 tine:{d:1.2,l:-17.5,lp:7500,L:[[587.33,0,.7],[880,.13,.9]]},
 wrap:{d:.35,l:-18.5,lp:7000,L:[[880,0,.12],[587.33,.11,.18]]},
 undo:{d:.2,l:-19.5,lp:6500,L:[[700,0,.12]]}
};
function ensureAudio(){
 if(muted)return null;
 try{
  const AudioCtx=window.AudioContext||window.webkitAudioContext;
  if(!AudioCtx)return null;
  if(!actx){
   actx=new AudioCtx();
   masterGain=actx.createGain();
   masterGain.gain.value=1;
   masterGain.connect(actx.destination);
  }
  if(actx.state==='suspended')actx.resume().catch(()=>{});
  return actx;
 }catch(e){return null}
}
function getWarmNoise(dur=0.8){
 const c=ensureAudio(); if(!c)return null;
 if(noiseBuf&&noiseBuf.duration>=dur)return noiseBuf;
 const len=Math.floor(c.sampleRate*dur), buf=c.createBuffer(1,len,c.sampleRate), ch=buf.getChannelData(0);
 let prev=0;
 for(let i=0;i<len;i++){
  const w=Math.random()*2-1;
  prev=(prev+.045*w)/1.045;
  ch[i]=prev*2.4;
 }
 noiseBuf=buf; return buf;
}
function playIntro(){
 if(muted||reduce||introPlayed)return;
 const c=ensureAudio(); if(!c||c.state!=='running')return;
 introPlayed=true;
 const now=c.currentTime, notes=[110,164.81,220,329.63];
 const lp=c.createBiquadFilter(); lp.type='lowpass'; lp.Q.value=2;
 lp.frequency.setValueAtTime(150,now);
 lp.frequency.exponentialRampToValueAtTime(1400,now+.9);
 lp.frequency.exponentialRampToValueAtTime(380,now+2.2);
 const bus=c.createGain();
 bus.gain.setValueAtTime(.0001,now);
 bus.gain.linearRampToValueAtTime(.19,now+.35);
 bus.gain.exponentialRampToValueAtTime(.0001,now+2.25);
 lp.connect(bus); bus.connect(masterGain);
 notes.forEach((fr,idx)=>{
  const osc=c.createOscillator(), g=c.createGain();
  osc.type=idx%2===0?'triangle':'sine';
  osc.frequency.setValueAtTime(fr*.995,now);
  osc.frequency.exponentialRampToValueAtTime(fr,now+.75);
  osc.detune.setValueAtTime((idx-1.5)*5,now);
  g.gain.value=1/(idx*.35+1);
  osc.connect(g); g.connect(lp);
  osc.start(now); osc.stop(now+2.3);
 });
}
function playWhoosh(){
 if(muted||reduce)return;
 const c=ensureAudio(), buf=getWarmNoise(.6); if(!c||!buf)return;
 const now=c.currentTime, src=c.createBufferSource(); src.buffer=buf;
 const bp=c.createBiquadFilter(); bp.type='bandpass'; bp.Q.value=1.5;
 bp.frequency.setValueAtTime(210,now);
 bp.frequency.exponentialRampToValueAtTime(1550,now+.22);
 bp.frequency.exponentialRampToValueAtTime(280,now+.52);
 const g=c.createGain();
 g.gain.setValueAtTime(.0001,now);
 g.gain.linearRampToValueAtTime(.16,now+.17);
 g.gain.exponentialRampToValueAtTime(.0001,now+.55);
 src.connect(bp); bp.connect(g); g.connect(masterGain);
 src.start(now); src.stop(now+.56);
}
function playRipple(){
 if(muted||reduce)return;
 const c=ensureAudio(); if(!c)return;
 const now=c.currentTime, osc=c.createOscillator(), g=c.createGain();
 osc.type='sine';
 osc.frequency.setValueAtTime(250,now);
 osc.frequency.exponentialRampToValueAtTime(110,now+.36);
 g.gain.setValueAtTime(.0001,now);
 g.gain.linearRampToValueAtTime(.13,now+.02);
 g.gain.exponentialRampToValueAtTime(.0001,now+.38);
 osc.connect(g); g.connect(masterGain);
 osc.start(now); osc.stop(now+.4);
}
function playHover(){
 if(muted||reduce)return;
 const ms=performance.now(); if(ms-lastHover<110)return; lastHover=ms;
 const c=ensureAudio(); if(!c||c.state!=='running')return;
 const now=c.currentTime, osc=c.createOscillator(), g=c.createGain();
 osc.type='sine';
 osc.frequency.setValueAtTime(520,now);
 osc.frequency.exponentialRampToValueAtTime(250,now+.03);
 g.gain.setValueAtTime(.0001,now);
 g.gain.linearRampToValueAtTime(.025,now+.004);
 g.gain.exponentialRampToValueAtTime(.0001,now+.035);
 osc.connect(g); g.connect(masterGain);
 osc.start(now); osc.stop(now+.04);
}
function play(name){
 if(muted)return;
 if(name==='intro')return playIntro();
 if(name==='whoosh')return playWhoosh();
 if(name==='ripple')return playRipple();
 if(name==='hover')return playHover();
 try{
  const c=ensureAudio(); if(!c)return;
  const spec=SND[name]||SND.tine, now=c.currentTime, g=c.createGain(), f=c.createBiquadFilter();
  g.gain.value=Math.pow(10,spec.l/20)*2.5; f.type='lowpass'; f.frequency.value=spec.lp;
  g.connect(f); f.connect(masterGain);
  spec.L.forEach(([fr,at,dec])=>{
   const o=c.createOscillator(), e=c.createGain(), s=now+at;
   o.frequency.value=fr; e.gain.setValueAtTime(.0001,s);
   e.gain.linearRampToValueAtTime(1,s+.005); e.gain.exponentialRampToValueAtTime(.0001,s+.015+dec);
   o.connect(e); e.connect(g); o.start(s); o.stop(s+dec+.1);
  });
 }catch(e){}
}
function syncSnd(){
 $('#snd i').className='fa-solid '+(muted?'fa-volume-xmark':'fa-volume-high');
 if(masterGain&&actx)masterGain.gain.setTargetAtTime(muted?0:1,actx.currentTime,.04);
}
$('#snd').onclick=()=>{muted=!muted;localStorage.setItem('mute',muted?'1':'0');syncSnd();if(!muted){ensureAudio();play('tine')}};

/* ---------- RENDER ---------- */
function applyStatic(){
 $$('[data-i]').forEach(el=>{const v=t(el.dataset.i); if(typeof v==='string')el.textContent=v});
 document.documentElement.lang=lang;
 $('#langT').textContent=lang==='vi'?'EN':'VI';
 splitHero();
 document.title=lang==='vi'?'Knowledge Hub - Tổ 3 • 11A12 • THPT Phú Hòa':'Knowledge Hub - Group 3 • 11A12 • Phu Hoa High School';
}
function renderPills(){ queueMicrotask(()=>{const c=$('#cap');if(c)c.textContent=t('cap')[modelIdx]});
 $('#pills').innerHTML=MODELS.map((m,i)=>`<button data-m="${i}" class="px-3 py-1 rounded-xl text-[11px] mono border transition ${i===modelIdx?'bg-sky-500/30 text-white border-sky-400/60':'bg-slate-900/80 text-slate-300 border-white/10 hover:border-sky-400/40'}"><i class="fa-solid ${m[1]} mr-1"></i>${esc(t('m')[i])}</button>`).join('');
}
function renderBento(){
 $('#bento').innerHTML=ITEMS.map((it,i)=>{const d=it[lang];
  return `<div class="sb full ${i===ITEMS.length-1?'md:col-span-4':'md:col-span-2'}" style="--trail:${it.col};--r:22px;--d:${4.8+i*.3}s;--g:.5" data-k="${it.k}" role="button" tabindex="0" data-aos="fade-up" data-aos-delay="${i*90}">
  <div class="sbi card p-6"><div class="w-12 h-12 rounded-2xl flex items-center justify-center text-xl mb-4 border shadow-lg" style="color:${it.col};background:${it.col}22;border-color:${it.col}55"><i class="fa-solid ${it.ic}"></i></div>
  ${it.num?`<div class="num" data-to="${it.num.to}" data-dec="${it.num.dec}" data-pre="${esc(d.np||'')}" data-suf="${esc((it.num.suf||'')+(d.ns||''))}">${fmtNum(0,it.num.dec,d.np,(it.num.suf||'')+(d.ns||''))}</div>`:''}
  <h3 class="text-xl font-bold glow mb-2">${esc(it.num?d.bh:d.h)}</h3><p class="text-xs text-slate-300 leading-relaxed mono">${esc(d.d)}</p></div></div>`}).join('');
 watchNums();
}
/* đếm số khi cuộn tới */
const fmtNum=(v,dec,pre,suf)=>(pre||'')+v.toLocaleString(lang==='vi'?'vi-VN':'en-US',{minimumFractionDigits:dec,maximumFractionDigits:dec})+(suf||'');
function countUp(el){
 const to=+el.dataset.to,dec=+el.dataset.dec,pre=el.dataset.pre,suf=el.dataset.suf;
 if(reduce){el.textContent=fmtNum(to,dec,pre,suf);return}
 const t0=performance.now(),D=1800;
 const step=now=>{const k=Math.min(1,(now-t0)/D),e=k===1?1:1-Math.pow(2,-10*k);
  el.textContent=fmtNum(to*e,dec,pre,suf);if(k<1)requestAnimationFrame(step)};
 requestAnimationFrame(step);
}
let numIO=null;
function watchNums(){
 const els=$$('#bento .num');
 if(!('IntersectionObserver' in window)){els.forEach(el=>el.textContent=fmtNum(+el.dataset.to,+el.dataset.dec,el.dataset.pre,el.dataset.suf));return}
 numIO&&numIO.disconnect();
 numIO=new IntersectionObserver(es=>es.forEach(en=>{if(en.isIntersecting){countUp(en.target);numIO.unobserve(en.target)}}),{threshold:.6});
 els.forEach(el=>numIO.observe(el));
}
function renderAcc(){
 $('#acc').innerHTML=['vi-tri','cong-nghe','nhan-luc','tong-von'].map(k=>{const it=ITEMS.find(x=>x.k===k),d=it[lang];
  return `<button class="acc-i" data-k="${k}">${imgTag(it.img,d.t)}<div class="acc-o"><h4 class="font-bold text-base" style="color:${it.col}">${esc(d.h)}</h4><p class="text-xs text-slate-300 truncate mono">${esc(d.s)}</p></div></button>`}).join('');
}
function renderMembers(){
 $('#members').innerHTML=`<div class="sb" data-kiet style="--d:3.5s;--g:.75" role="button" tabindex="0"><span class="sbi px-4 py-2 text-sky-300 font-bold flex items-center hover:text-white transition"><i class="fa-solid fa-crown text-amber-400 mr-1.5"></i>${esc(t('dev'))}</span></div>`
 +MEMBERS.slice(0,3).map(n=>chip(n)).join('')
 +`<button data-n="Thanh Vy" class="px-4 py-2 bg-sky-500/20 text-sky-400 font-bold rounded-xl border border-sky-500/40 hover:bg-sky-500/30 transition">${esc(t('lead'))}</button>`
 +MEMBERS.slice(3).map(n=>chip(n)).join('');
}
const chip=n=>`<button data-n="${esc(n)}" class="px-3.5 py-2 bg-slate-900/80 rounded-xl border border-white/10 hover:border-sky-500/50 transition">${esc(n)}</button>`;
function renderAll(){applyStatic();renderChips();rotTick();renderPills();renderBento();renderAcc();renderMembers();buildCarousel();buildParallax();window.AOS&&AOS.refreshHard&&AOS.refreshHard()}

/* ---------- MODAL ---------- */
let typer=null, lastFocus=null;
function type(el,text){
 clearInterval(typer); el.textContent='';
 if(reduce){el.textContent=text;return}
 let i=0; el.classList.add('cur');
 typer=setInterval(()=>{el.textContent=text.slice(0,++i);if(i>=text.length){clearInterval(typer);el.classList.remove('cur')}},15);
}
function openModal(html,after){
 lastFocus=document.activeElement;
 $('#mbody').innerHTML=html;
 $('#modal').classList.remove('hide');
 const c=$('#mcard'); c.classList.remove('enter'); void c.offsetWidth; c.classList.add('enter');
 document.body.style.overflow='hidden'; $('#mclose').focus();
 if(after)after();
}
function closeModal(){
 if($('#modal').classList.contains('hide'))return;
 play('undo'); clearInterval(typer);
 $('#modal').classList.add('hide'); document.body.style.overflow='';
 if(lastFocus&&lastFocus.focus)lastFocus.focus();
}
$('#mclose').onclick=closeModal;
$('#modal').addEventListener('click',e=>{if(e.target.id==='modal')closeModal()});
addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});

const head=(icon,badge,title)=>`<div class="flex items-center gap-3.5 mb-4 pr-10"><div class="w-11 h-11 rounded-2xl bg-sky-500/20 text-sky-400 flex items-center justify-center text-xl shrink-0 border border-sky-400/40"><i class="fa-solid ${icon}"></i></div><div><span class="text-[10px] text-sky-400 mono tracking-widest font-bold">${esc(badge)}</span><h3 class="text-lg sm:text-xl font-bold glow leading-snug">${esc(title)}</h3></div></div>`;
function openDetail(k){
 const it=ITEMS.find(x=>x.k===k); if(!it)return; const d=it[lang]; play('tine');
 openModal(head(it.ic,'FDI DATA BANK • 11A12',d.h)
  +`<div class="mb-5 overflow-hidden rounded-2xl border border-white/10 h-48 sm:h-56 bg-slate-900">${imgTag(it.img,d.h,'w-full h-full object-cover')}</div>
  <div id="tw" class="text-sm text-slate-200 leading-relaxed mono min-h-[100px] whitespace-pre-wrap break-words"></div>`,
  ()=>type($('#tw'),d.x));
}
