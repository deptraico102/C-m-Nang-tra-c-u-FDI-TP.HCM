 <span class="px-3 py-1 rounded-full bg-sky-500/20 text-sky-400 text-[10px] mono font-bold border border-sky-400/30">${esc(t('g3b'))}</span>
 <h3 class="text-2xl font-black glow mt-2 mb-4">${esc(t('g3t'))}</h3></div>
