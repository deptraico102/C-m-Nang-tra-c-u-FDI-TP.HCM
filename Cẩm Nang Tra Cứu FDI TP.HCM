
<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Knowledge Hub - Thu hút FDI tại TP.HCM - Tổ 3 • 11A12 • THPT Phú Hòa">
<meta name="theme-color" content="#030712">
<title>Knowledge Hub - Tổ 3 • 11A12 • THPT Phú Hòa</title>
<script src="https://cdn.tailwindcss.com"></script>
<script>tailwind.config={darkMode:'class'}</script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800;900&display=swap&subset=vietnamese" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<style>
@property --a{syntax:'<angle>';initial-value:0deg;inherits:false}
:root{--sky:#38BDF8}
html{scroll-behavior:smooth}
body{font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Inter","Be Vietnam Pro","Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;background:#0e0d12;color:#f8fafc;min-height:100vh}
.mono{font-family:inherit;letter-spacing:.01em}
:focus-visible{outline:2px solid var(--sky);outline-offset:3px}
.orb{position:fixed;z-index:0;pointer-events:none;border-radius:50%}
#vn-bg{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;background:#000}
#vn-bg-img{width:100%;height:100%;object-fit:cover;opacity:.72;filter:brightness(.74) contrast(1.06);transition:opacity .45s ease,filter .45s ease,transform .6s ease}
#vn-bg-scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.45) 0%,rgba(0,0,0,.78) 100%);transition:background .45s ease}
body.fdi-dim-bg #vn-bg-img{opacity:.2;filter:brightness(.36) blur(2px);transform:scale(1.02)}
body.fdi-dim-bg #vn-bg-scrim{background:linear-gradient(180deg,rgba(0,0,0,.78) 0%,rgba(0,0,0,.93) 100%)}
.o1{top:-15%;left:15%;width:550px;height:550px;background:radial-gradient(circle,rgba(56,189,248,.14),transparent 70%);filter:blur(60px)}
.o2{bottom:10%;right:10%;width:500px;height:500px;background:radial-gradient(circle,rgba(125,211,252,.1),transparent 70%);filter:blur(70px)}
.glow,.silver{padding:.14em 0;line-height:1.3}
.glow{background:linear-gradient(180deg,#fff,#94a3b8);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.silver{background:linear-gradient(135deg,#fff,#E2E8F0 50%,#38BDF8);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.glass{background:rgba(15,23,42,.65);backdrop-filter:blur(24px) saturate(180%);-webkit-backdrop-filter:blur(24px) saturate(180%);border:1px solid rgba(56,189,248,.18);box-shadow:0 20px 50px rgba(0,0,0,.55)}
#progress{position:fixed;top:0;left:0;height:3px;width:0;z-index:60;background:linear-gradient(90deg,#38BDF8,#fff)}
/* viền thẻ */
.sb{--c:#fff;--trail:#38BDF8;--d:4s;--r:12px;--g:.6;position:relative;display:inline-flex;border-radius:var(--r);padding:1.5px;overflow:hidden;isolation:isolate;cursor:pointer}
.sb::before,.sb::after{content:'';position:absolute;inset:-150%;animation:orbit var(--d) linear infinite}
.sb::before{background:conic-gradient(from var(--a),transparent 0 240deg,color-mix(in srgb,var(--trail) 40%,transparent) 290deg,var(--trail) 345deg,var(--c) 358deg,transparent 360deg);z-index:-2}
.sb::after{background:conic-gradient(from var(--a),transparent 0 270deg,var(--c) 355deg,transparent 360deg);filter:blur(calc(12px*var(--g)));opacity:var(--g);z-index:-1}
.sb:hover::before,.sb:hover::after{animation-duration:calc(var(--d)*.42)}
.sbi{position:relative;width:100%;border-radius:calc(var(--r) - 1.5px);background:rgba(10,15,29,.92);z-index:1}
.sb.full{display:flex;width:100%}
@keyframes orbit{to{--a:360deg}}
@supports not (background:conic-gradient(from var(--a),red,blue)){.sb{border:1px solid rgba(56,189,248,.4)}}
.pulse{position:absolute;inset:0;border-radius:inherit;pointer-events:none;z-index:10;animation:pulse .6s forwards}
@keyframes pulse{0%{box-shadow:0 0 0 0 #fff;opacity:.9}100%{box-shadow:0 0 24px 8px transparent;opacity:0}}
/* model */
.float{animation:float 4.5s ease-in-out infinite}
@keyframes float{50%{transform:translateY(-12px)}}
model-viewer{width:100%;height:min(440px,60vw);min-height:300px;background:transparent;--poster-color:transparent;outline:none}
/* bento */
.card{overflow:hidden;position:relative;transition:transform .4s cubic-bezier(.16,1,.3,1)}
.card:hover{transform:translateY(-4px)}
.card::before{content:'';position:absolute;top:var(--my,-100px);left:var(--mx,-100px);width:320px;height:320px;background:radial-gradient(circle,rgba(56,189,248,.26),transparent 70%);transform:translate(-50%,-50%);pointer-events:none;opacity:0;transition:opacity .3s}
.card:hover::before{opacity:1}
/* accordion */
.acc{display:flex;gap:16px;height:400px}
.acc-i{flex:1;border-radius:24px;overflow:hidden;position:relative;cursor:pointer;border:1px solid rgba(56,189,248,.2);background:#0f172a;transition:flex .65s cubic-bezier(.16,1,.3,1),filter .35s;text-align:left}
.acc:hover .acc-i:not(:hover){filter:blur(1.5px) brightness(.75)}
.acc-i:hover,.acc-i:focus-visible{flex:4}
.acc-i img{width:100%;height:100%;object-fit:cover;transition:transform .7s}
.acc-i:hover img{transform:scale(1.06)}
.acc-o{position:absolute;inset:0;background:linear-gradient(0deg,rgba(3,7,18,.95),rgba(3,7,18,.3) 50%,transparent);display:flex;flex-direction:column;justify-content:flex-end;padding:24px}
@media(max-width:767px){.acc{flex-direction:column;height:auto}.acc-i{flex:none;height:140px}.acc:hover .acc-i:not(:hover){filter:none}}
/* orbit */
#orbit{position:relative;height:460px;touch-action:pan-y;cursor:grab;user-select:none;-webkit-user-select:none}
#orbit.drag{cursor:grabbing}
.o-ring{position:absolute;left:50%;top:50%;width:76%;height:52%;transform:translate(-50%,-50%);border:1px dashed rgba(56,189,248,.28);border-radius:50%;pointer-events:none}
.o-core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:92px;height:92px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:22px;color:#fff;background:radial-gradient(circle,rgba(56,189,248,.45),rgba(56,189,248,.05) 70%);box-shadow:0 0 60px rgba(56,189,248,.4);pointer-events:none}
.oc{position:absolute;left:50%;top:50%;width:150px;height:190px;border-radius:18px;overflow:hidden;border:1px solid rgba(56,189,248,.4);background:#0f172a;box-shadow:0 18px 36px rgba(0,0,0,.7);will-change:transform;padding:0}
.oc img{width:100%;height:100%;object-fit:cover;pointer-events:none;display:block}
.oc span{position:absolute;inset:auto 0 0 0;padding:26px 10px 9px;text-align:left;font-size:12px;font-weight:700;color:#bae6fd;background:linear-gradient(0deg,rgba(3,7,18,.95),transparent);line-height:1.3}
.oc small{display:block;font-size:10px;font-weight:500;color:#cbd5e1}
@media(max-width:640px){#orbit{height:380px}.oc{width:106px;height:140px}.oc span{font-size:10px;padding-top:18px}.oc small{display:none}}
/* modal */
#modal{transition:opacity .3s}
#modal.hide{opacity:0;pointer-events:none}
.enter{animation:menter .42s cubic-bezier(.16,1,.3,1) forwards}
@keyframes menter{0%{opacity:0;transform:scale(.9) translateY(24px);filter:blur(16px)}60%{filter:blur(3px)}100%{opacity:1;transform:none;filter:none}}
.cur::after{content:'|';animation:blink .7s infinite;color:#38BDF8;font-weight:700}
@keyframes blink{50%{opacity:0}}
.toast{transition:all .3s;transform:translateY(16px);opacity:0}
.toast.in{transform:none;opacity:1}
#preloader{transition:opacity .7s}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
#hdr.sc{background:rgba(14,13,18,.72);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid rgba(255,255,255,.08)}
section[id]{scroll-margin-top:90px}

/* ===== APPLE STYLE ===== */
body{background:#000;color:#f5f5f7}
#hdr .max-w-6xl{padding-top:0;padding-bottom:0;height:48px}
#hdr.sc{background:rgba(22,22,23,.8);backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);border-bottom:1px solid rgba(255,255,255,.1)}
#hdr nav a{font-size:12px;opacity:.82;color:#f5f5f7!important}
#hdr nav a:hover{opacity:1}
#logo3,#snd,#lang{background:transparent!important;border:none!important;border-radius:980px;color:#e8e8ed}
#logo3{width:30px;height:30px;font-size:15px}
#snd,#lang{height:30px;font-size:12px}
#snd:hover,#lang:hover,#logo3:hover{background:rgba(255,255,255,.1)!important}
#home span:first-child{letter-spacing:.12em}
.glass{background:#1d1d1f;backdrop-filter:none;-webkit-backdrop-filter:none;border:none;box-shadow:none;border-radius:28px}
#mcard.glass{background:rgba(29,29,31,.94);backdrop-filter:blur(24px)}
.sb::before,.sb::after{display:none}
.sb{padding:0;border:1px solid rgba(255,255,255,.08);transition:transform .35s cubic-bezier(.16,1,.3,1),border-color .3s}
.sb:hover{border-color:rgba(255,255,255,.2)}
.sb.full:hover{transform:scale(1.015)}
.sb:not(.full){border-radius:980px}
.sb:not(.full) .sbi{border-radius:980px}
.sbi{background:#1d1d1f}
.card::before{display:none}
.card:hover{transform:none}
#bento h3{font-size:clamp(22px,2.4vw,30px);font-weight:600;letter-spacing:-.01em}
#bento p{font-size:15px;line-height:1.5;color:#a1a1a6!important}
#bento .card{padding:2rem}
.glow,.silver{background:none!important;-webkit-text-fill-color:#f5f5f7;color:#f5f5f7}
#wrap h2,#wrap h3.silver{font-size:clamp(30px,4.6vw,52px);font-weight:600;letter-spacing:-.025em;line-height:1.15;text-align:center;color:#f5f5f7!important;-webkit-text-fill-color:#f5f5f7}
#wrap h2 i,#wrap h3.silver i{display:none}
#wrap h2 .mono{font-family:inherit}
.text-slate-300,.text-slate-200{color:#a1a1a6!important}
.text-sky-400,.text-sky-300{color:#2997ff!important}
#wrap .text-sky-400{color:#2997ff!important}
.acc-i{border:none;border-radius:28px}
.mono{letter-spacing:0}
#members button,#members .sb{border-radius:980px}
#members button{background:#1d1d1f;border:none;color:#e8e8ed}
#members button:hover{background:#2a2a2d}
#pills button{border-radius:980px;border:none;background:#2a2a2d!important;color:#e8e8ed!important;font-size:13px}
#pills button.bg-sky-500\/30{background:#f5f5f7!important;color:#1d1d1f!important}
.toast{border-radius:18px}
#px{position:relative;height:min(92vh,860px);overflow:hidden;border-radius:28px;background:#1d1d1f}
#px::before,#px::after{content:'';position:absolute;left:0;right:0;height:90px;z-index:3;pointer-events:none}
#px::before{top:0;background:linear-gradient(#1d1d1f,transparent)}
#px::after{bottom:0;background:linear-gradient(transparent,#1d1d1f)}
#px .grid3{position:absolute;inset:0;display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding:0 14px}
.px-col{display:flex;flex-direction:column;gap:14px;will-change:transform}
.px-col:nth-child(1){margin-top:-18vh}.px-col:nth-child(2){margin-top:-42vh}.px-col:nth-child(3){margin-top:-8vh}
.pxc{position:relative;display:block;width:100%;height:clamp(200px,36vh,360px);border-radius:20px;overflow:hidden;background:#0f0f10;padding:0;cursor:pointer;flex:none}
.pxc img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.16,1,.3,1)}
.pxc:hover img{transform:scale(1.06)}
.pxc span{position:absolute;left:0;right:0;bottom:0;padding:34px 14px 12px;text-align:left;font-size:14px;font-weight:600;color:#f5f5f7;background:linear-gradient(0deg,rgba(0,0,0,.8),transparent)}
.pxc small{display:block;font-size:12px;font-weight:400;color:#a1a1a6}
@media(max-width:640px){#px .grid3{gap:8px;padding:0 8px}.px-col{gap:8px}.pxc{border-radius:14px}.pxc span{font-size:11px;padding:24px 8px 8px}.pxc small{display:none}}

/* ===== TRANG CHỦ ===== */
#heroFx{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:0;-webkit-mask-image:radial-gradient(ellipse at center,#000 35%,transparent 78%);mask-image:radial-gradient(ellipse at center,#000 35%,transparent 78%)}
.rise{opacity:0;transform:translateY(22px);animation:rise .9s cubic-bezier(.16,1,.3,1) forwards;animation-delay:var(--d,0s)}
@keyframes rise{to{opacity:1;transform:none}}
.hw{display:inline-block;opacity:0;transform:translateY(28px);filter:blur(14px);animation:hw .95s cubic-bezier(.16,1,.3,1) forwards;animation-delay:calc(1s + var(--i)*65ms)}
@keyframes hw{to{opacity:1;transform:none;filter:blur(0)}}
.fdi .hw{background:linear-gradient(90deg,#2997ff,#7dd3fc,#fff,#7dd3fc,#2997ff);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;animation:hw .95s cubic-bezier(.16,1,.3,1) forwards,shine 6s linear infinite;animation-delay:calc(1s + var(--i)*65ms),0s}
@keyframes shine{to{background-position:-300% 0}}
.hero-badge{display:inline-flex;align-items:center;gap:8px;padding:7px 15px;border-radius:980px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);font-size:12px;color:#d2d2d7;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.hero-badge .dot{width:7px;height:7px;border-radius:50%;background:#30d158;animation:dotp 2s infinite}
@keyframes dotp{0%{box-shadow:0 0 0 0 rgba(48,209,88,.6)}100%{box-shadow:0 0 0 9px rgba(48,209,88,0)}}
.hero-rot{font-size:clamp(16px,2.2vw,22px);color:#a1a1a6;min-height:1.7em}
#rot{display:inline-block;color:#2997ff;font-weight:600}
.rin{animation:rin .6s cubic-bezier(.16,1,.3,1)}
@keyframes rin{from{opacity:0;transform:translateY(12px);filter:blur(6px)}to{opacity:1;transform:none;filter:none}}
.btn-shine{position:relative;overflow:hidden}
.btn-shine::after{content:'';position:absolute;top:0;left:-60%;width:40%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.38),transparent);transform:skewX(-20deg);animation:sweep 3.6s ease-in-out 3s infinite}
@keyframes sweep{0%{left:-60%}35%,100%{left:130%}}
.hero-chips{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;padding-top:26px}
.hc{display:flex;align-items:center;gap:12px;padding:12px 18px;border-radius:20px;background:rgba(29,29,31,.7);border:1px solid rgba(255,255,255,.08);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);text-align:left;animation:bob 6s ease-in-out infinite}
.hc i{color:#2997ff;font-size:18px}
.hc b{display:block;font-size:17px;font-weight:600;color:#f5f5f7;letter-spacing:-.01em}
.hc small{font-size:12px;color:#a1a1a6}
@keyframes bob{50%{transform:translateY(-8px)}}
.hero-cue{position:absolute;left:50%;bottom:26px;transform:translateX(-50%);z-index:5}
.cue-m{display:block;width:24px;height:38px;border:2px solid rgba(255,255,255,.4);border-radius:14px;position:relative}
.cue-m i{position:absolute;left:50%;top:7px;width:3px;height:8px;margin-left:-1.5px;border-radius:2px;background:#f5f5f7;animation:wheel 1.8s ease-in-out infinite}
@keyframes wheel{0%{opacity:0;transform:translateY(0)}30%{opacity:1}100%{opacity:0;transform:translateY(14px)}}
@media(max-width:640px){.hero-cue{display:none}.hc{padding:10px 14px}}
/* ===== SỐ LIỆU NỔI BẬT ===== */
.num{font-size:clamp(44px,5.4vw,72px);font-weight:600;letter-spacing:-.035em;line-height:1.05;margin-bottom:.5rem;font-variant-numeric:tabular-nums;background:linear-gradient(135deg,#f5f5f7 20%,#2997ff);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
/* ===== GIỚI THIỆU TOÀN MÀN HÌNH ===== */
#se{width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw)}
.se-track{position:relative}
.se-stage{position:sticky;top:0;height:100svh;overflow:hidden;display:flex;align-items:center;justify-content:center;background:#000}
.se-frame{position:absolute;inset:0;overflow:hidden;will-change:clip-path;clip-path:inset(21% 29% 21% 29% round 24px)}
.se-media{width:100%;height:100%;object-fit:cover;transform-origin:center;will-change:transform;display:block;transform:scale(1.35)}
.se-scrim{position:absolute;inset:0;background:#000;opacity:0;pointer-events:none}
.se-overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:0 24px;opacity:0;will-change:opacity,transform}
.se-overlay h3{font-size:clamp(28px,5vw,60px);font-weight:600;letter-spacing:-.025em;line-height:1.15;color:#f5f5f7}
.se-overlay p{margin-top:14px;max-width:640px;font-size:clamp(15px,2vw,21px);color:#d2d2d7}
.se-title{position:absolute;z-index:2;left:0;right:0;text-align:center;padding:0 20px;pointer-events:none;font-weight:600;letter-spacing:-.03em;line-height:1.1;font-size:var(--se-title-size,56px);color:#f5f5f7;text-shadow:0 2px 30px rgba(0,0,0,.6);will-change:opacity,transform}
.se-hint{position:absolute;z-index:2;bottom:6vh;left:0;right:0;text-align:center;font-size:13px;color:#a1a1a6;pointer-events:none;letter-spacing:.04em}
</style>
</head>
<body class="flex flex-col overflow-x-hidden relative">
<div id="progress"></div>
<div id="vn-bg" aria-hidden="true">
  <img id="vn-bg-img" src="https://phuongtanphuoc.com/wp/2025/TPHCM/anh-dep-tp-HCM%20%283%29.jpg" alt="">
  <div id="vn-bg-scrim"></div>
</div>

<div id="preloader" class="fixed inset-0 z-[200] bg-[#030712] flex flex-col items-center justify-center cursor-pointer" role="status">
  <div class="relative flex items-center justify-center mb-6">
    <div class="absolute w-32 h-32 rounded-full border-2 border-sky-400/30 animate-ping"></div>
    <div class="sb" style="--r:24px;--d:2.5s;--g:.85"><div class="sbi w-24 h-24 flex items-center justify-center text-white text-4xl font-black">3</div></div>
  </div>
  <h2 class="text-xs font-bold tracking-[.3em] text-sky-400 uppercase mono" data-i="org"></h2>
  <p class="text-[11px] text-slate-400 mono animate-pulse mt-2" data-i="load"></p>
</div>

<div id="toasts" class="fixed bottom-6 right-4 sm:right-6 z-[150] space-y-3 pointer-events-none" aria-live="polite"></div>

<!-- Modal dùng chung -->
<div id="modal" class="hide fixed inset-0 z-[130] bg-black/80 backdrop-blur-xl flex items-center justify-center p-4" role="dialog" aria-modal="true">
  <div id="mcard" class="relative max-w-2xl w-full glass rounded-3xl p-7 sm:p-9 max-h-[90vh] flex flex-col border border-sky-400/40">
    <button id="mclose" aria-label="Close" class="absolute top-5 right-5 text-slate-400 hover:text-white bg-slate-900/80 w-9 h-9 rounded-full flex items-center justify-center z-20"><i class="fa-solid fa-xmark"></i></button>
    <div id="mbody" class="overflow-y-auto"></div>
  </div>
</div>

<header id="hdr" class="fixed top-0 inset-x-0 z-40 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <button id="logo3" class="w-9 h-9 rounded-xl bg-white/10 border border-white/20 text-white font-bold hover:bg-white/20 transition" aria-label="3">3</button>
      <button id="home" class="text-left leading-tight"><span class="block text-[11px] sm:text-xs font-bold tracking-widest text-white uppercase" data-i="org"></span><span class="block text-[10px] text-slate-400">3D Knowledge Hub</span></button>
    </div>
    <nav class="hidden md:flex items-center gap-9 text-sm text-slate-300">
      <a href="#figures" class="hover:text-white transition" data-i="nv1"></a>
      <a href="#gallery" class="hover:text-white transition" data-i="nv2"></a>
      <a href="#model" class="hover:text-white transition" data-i="nv3"></a>
    </nav>
    <div class="flex items-center gap-2 text-sm">
      <button id="snd" class="w-9 h-9 rounded-xl bg-white/10 text-slate-200 border border-white/10 hover:bg-white/20 transition" aria-label="Sound"><i class="fa-solid fa-volume-high"></i></button>
      <button id="lang" class="px-3 h-9 rounded-xl bg-white/10 text-slate-100 border border-white/10 font-semibold hover:bg-white/20 transition"><i class="fa-solid fa-globe mr-1"></i><span id="langT">EN</span></button>
      <button id="t2" class="px-3.5 h-8 rounded-full bg-[#0071e3] text-white text-xs font-medium hover:bg-[#0077ed] transition"><span data-i="t2"></span></button>
    </div>
  </div>
</header>

<main id="topic" class="max-w-6xl mx-auto px-4 py-8 w-full flex-grow z-10 relative">
<div id="wrap" class="space-y-28">

