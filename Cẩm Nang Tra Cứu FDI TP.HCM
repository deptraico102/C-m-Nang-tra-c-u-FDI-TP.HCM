 openModal(`<div class="text-center"><div class="w-28 h-28 mx-auto mb-4 rounded-3xl overflow-hidden border-2 border-sky-400 shadow-xl shadow-sky-500/30 bg-slate-900">${imgTag('https://i.postimg.cc/PJ50zJJL/kiet.webp','Võ Tuấn Kiệt','w-full h-full object-cover')}</div>
 <span class="px-3.5 py-1 rounded-full bg-sky-500/20 text-sky-400 text-[10px] mono font-bold border border-sky-400/40">${esc(t('kb'))}</span>
 <h3 class="text-2xl font-black glow mt-2">VÕ TUẤN KIỆT</h3><p class="text-[11px] text-sky-300 mono mt-1">${esc(t('kl'))}</p>
 <div class="mt-4 p-4 rounded-2xl bg-slate-950/90 border border-white/10 text-left"><div id="tw" class="text-xs text-slate-200 mono min-h-[40px] whitespace-pre-wrap"></div></div></div>`,
 ()=>type($('#tw'),t('kbio')));
}

/* ---------- TOAST ---------- */
function toast(html,title){
 const el=document.createElement('div');
 el.className='toast pointer-events-auto bg-slate-900/95 border-2 border-sky-400/80 border-l-4 text-slate-100 px-4 py-3 rounded-2xl shadow-2xl mono text-xs max-w-[calc(100vw-2rem)] sm:max-w-sm space-y-1 backdrop-blur-lg';
 el.innerHTML=(title?`<div class="text-sky-400 font-bold text-[11px]"><i class="fa-solid fa-shield-halved mr-1.5"></i>${esc(title)}</div>`:'')+`<div>${html}</div>`;
 $('#toasts').appendChild(el); requestAnimationFrame(()=>el.classList.add('in'));
 setTimeout(()=>{el.classList.remove('in');setTimeout(()=>el.remove(),300)},3500);
}

/* ---------- 3D FDI TP.HCM (Three.js) ---------- */
$('#pills').addEventListener('click',e=>{const b=e.target.closest('[data-m]');if(!b)return;modelIdx=+b.dataset.m;play('tine');renderPills();window.setFDIScene&&setFDIScene(modelIdx)});
$('#reset').onclick=()=>{play('tine');window.fdiReset&&fdiReset()};
function initFDI3D(){
 const cv=$('#fdi3d');
 if(typeof THREE==='undefined'){cv.replaceWith(Object.assign(document.createElement('p'),{className:'p-10 text-sm text-slate-300',textContent:'Cần kết nối mạng để tải Three.js / Requires internet to load Three.js'}));return}
 let R;try{R=new THREE.WebGLRenderer({canvas:cv,antialias:true,alpha:true})}catch(e){return}
 R.setPixelRatio(Math.min(devicePixelRatio||1,2));
 const sc=new THREE.Scene(),cam=new THREE.PerspectiveCamera(40,1,.1,100),pivot=new THREE.Group();
 sc.add(new THREE.AmbientLight(0xbfdfff,.75));
 const dl=new THREE.DirectionalLight(0xffffff,1);dl.position.set(5,10,6);sc.add(dl);
 const pl=new THREE.PointLight(0x38bdf8,1.4,40);pl.position.set(-6,5,-4);sc.add(pl);
 pivot.position.y=-1.3;sc.add(pivot);
 let cur=null,anim=[],born=0,ry=.6,rx=.45,dist=15,drag=false,px=0,py=0,lastInt=0,vis=true;
 const M=(c,e=0,i=0,m=.3)=>new THREE.MeshStandardMaterial({color:c,roughness:.5,metalness:m,emissive:e,emissiveIntensity:i});
 const bx=(g,w,h,d,mat,x,y,z,edge)=>{const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);m.position.set(x,y+h/2,z);
  if(edge)m.add(new THREE.LineSegments(new THREE.EdgesGeometry(m.geometry),new THREE.LineBasicMaterial({color:0x7dd3fc,transparent:true,opacity:.35})));g.add(m);return m};
 const rng=seed=>{let sd=seed;return()=>(sd=sd*16807%2147483647)/2147483647};
 let tNow=0,waters=[],lastF=performance.now(),mv=0;
 /* mặt nước: sóng chồng nhau + sóng lan tròn khi có tác động */
 function makeWater(w,d,nx,nz,col){
  const geo=new THREE.PlaneGeometry(w,d,nx,nz);geo.rotateX(-Math.PI/2);
  const mesh=new THREE.Mesh(geo,new THREE.MeshStandardMaterial({color:col,emissive:0x0284c7,emissiveIntensity:.6,roughness:.25,metalness:.55,transparent:true,opacity:.92,flatShading:true}));
  const pos=geo.attributes.position,b0=new Float32Array(pos.array),rip=[];
  const H=(x,z,t)=>{let h=.045*Math.sin(x*2.3+t*1.7)+.04*Math.sin(z*1.6-t*1.35)+.022*Math.sin((x+z)*3.4+t*2.5);
   for(const r of rip){const age=t-r.t;if(age<0)continue;const k=Math.hypot(x-r.x,z-r.z)-age*1.3;h+=.11*Math.exp(-age*.8)*Math.exp(-k*k*12)*Math.cos(k*13)}
   return h};
  function ripple(x,z){rip.push({x:x,z:z,t:tNow});if(rip.length>14)rip.shift()}
  function update(t){
   if(rip.length&&t-rip[0].t>4)rip.shift();
   for(let i=0;i<pos.count;i++){pos.setY(i,H(b0[i*3],b0[i*3+2],t))}
   pos.needsUpdate=true;
  }
  const o={mesh:mesh,H:H,ripple:ripple,update:update};
  waters.push(o);return o;
 }
 /* vật nổi: lò xo + giảm chấn theo độ cao sóng, nghiêng theo độ dốc mặt nước */
 function floater(obj,w,sx,sz,base,k,c){
  let y=base,vy=0,rx=0,rz=0;
  return (t,dt)=>{const x=sx(),z=sz(),h=w.H(x,z,t);
   vy+=((base+h-y)*k-vy*c)*dt;y+=vy*dt;obj.position.y=y;
   const e=.2,hx=(w.H(x+e,z,t)-w.H(x-e,z,t))/(2*e),hz=(w.H(x,z+e,t)-w.H(x,z-e,t))/(2*e),a=Math.min(1,dt*6);
   rz+=(Math.atan(hx)-rz)*a;rx+=(-Math.atan(hz)-rx)*a;obj.rotation.z=rz;obj.rotation.x=rx};
 }

 /* Cảnh 1: đô thị TP.HCM */
 function city(){
  const g=new THREE.Group(),rnd=rng(7);
  const base=new THREE.Mesh(new THREE.CylinderGeometry(6.3,6.5,.3,64),M(0x0b1220,0x0b3a5a,.4));base.position.y=-.15;g.add(base);
  const ang=.35,cs=Math.cos(ang),sn=Math.sin(ang);
  const wr=makeWater(1.2,11.6,6,48,0x0ea5e9),rv=new THREE.Group();rv.position.set(2.4,.03,0);rv.rotation.y=ang;rv.add(wr.mesh);g.add(rv);
  [0,.5].forEach((ph,bi)=>{
   const b=new THREE.Group();b.position.x=bi?.22:-.22;rv.add(b);
   bx(b,.3,.1,.64,M(0xf8fafc,0xffffff,.25),0,-.03,0);bx(b,.18,.1,.2,M(0x38bdf8,0x38bdf8,.6),0,.07,-.08,true);
   const fl=floater(b,wr,()=>b.position.x,()=>b.position.z,0,60,6);let wk=0;
   anim.push((t,dt)=>{b.position.z=5.4-((t*.3+ph)%1)*10.8;fl(t,dt);wk+=dt;if(wk>.7){wk=0;wr.ripple(b.position.x,b.position.z+.4)}});
  });
  const pal=[0x1e3a5f,0x1e293b,0x334155,0x27456b];
  for(let i=-5;i<=5;i++)for(let j=-5;j<=5;j++){
   const x=i*1.05+(rnd()-.5)*.2,z=j*1.05+(rnd()-.5)*.2;
   if(Math.hypot(x,z)>5.6||Math.abs((x-2.4)*cs-z*sn)<1)continue;
   if(Math.hypot(x+1.2,z+.5)<1.1||Math.hypot(x-.9,z-1.4)<1)continue;
   const h=.25+rnd()*Math.max(.3,1.3-Math.hypot(x,z)*.12);
   bx(g,.62,h,.62,M(pal[(rnd()*4)|0],0x0b3a5a,.25),x,0,z,true);
  }
  const lm=M(0x38bdf8,0x38bdf8,.55,.6);let y=0;
  [1,.92,.84,.74,.64,.54,.44].forEach(w=>{bx(g,w,.62,w,lm,-1.2,y,-.5,true);y+=.62});
  const sp=new THREE.Mesh(new THREE.CylinderGeometry(.015,.05,1.1,8),M(0xffffff,0xffffff,1));sp.position.set(-1.2,y+.55,-.5);g.add(sp);
  const bt=new THREE.Mesh(new THREE.CylinderGeometry(.22,.46,2.9,8),M(0xa5f3fc,0x7dd3fc,.5,.6));bt.position.set(.9,1.45,1.4);g.add(bt);
  bx(g,.55,.06,.5,M(0xe2e8f0,0xffffff,.5),1.2,2.1,1.4);
  [1.6,2.2,1.3,1.9].forEach((h,k)=>bx(g,.55,h,.55,M(0x7dd3fc,0x38bdf8,.35,.6),3.7+k*.7,0,-2.4+(k%2)*.9,true));
  anim.push(t=>{sp.material.emissiveIntensity=.5+.5*Math.sin(t*3);lm.emissiveIntensity=.5+.15*Math.sin(t*1.5)});
  return g;
 }

 /* Cảnh 2: cảng Cát Lái */
 function port(){
  const g=new THREE.Group(),rnd=rng(11);
  bx(g,8.8,.25,6.2,M(0x111827,0x0b3a5a,.3),-1.1,-.25,0,true);
  bx(g,2.4,.1,6.2,M(0x082f49,0x0b3a5a,.3),4.5,-.3,0);
  const pw=makeWater(2.4,6.2,8,26,0x0ea5e9);pw.mesh.position.set(4.5,-.12,0);g.add(pw.mesh);
  const mats=[0xef4444,0x38bdf8,0xf59e0b,0x10b981,0xe2e8f0,0x6366f1].map(c=>M(c,0,0,.2));
  for(let c=0;c<8;c++)for(let r=0;r<6;r++){const n=1+((rnd()*3)|0),m=mats[(rnd()*6)|0];for(let k=0;k<n;k++)bx(g,.85,.36,.4,m,-5+c*.95,k*.38,-2+r*.8)}
  const cm=M(0xfbbf24,0xb45309,.25,.5);
  [-1.5,1.5].forEach(z=>{[2.3,3.2].forEach(x=>bx(g,.14,2.9,.14,cm,x,0,z));bx(g,6.2,.16,.16,cm,2.5,2.9,z)});
  [2.3,3.2].forEach(x=>bx(g,.16,.16,3.2,cm,x,2.9,0));
  const tr=new THREE.Group();tr.position.set(2.9,3.06,0);g.add(tr);
  bx(tr,.5,.18,.9,M(0xf8fafc),0,-.09,0);
  const pd=new THREE.Group();pd.position.y=-.09;tr.add(pd);
  bx(pd,.03,1.3,.03,M(0x94a3b8),0,-1.31,0);bx(pd,.85,.36,.4,mats[0],0,-1.71,0);
  const sh=new THREE.Group(),sp=new THREE.Group();sp.position.set(4.55,0,0);sh.position.x=-4.55;sp.add(sh);g.add(sp);
  bx(sh,1.5,.5,5.4,M(0x1e293b,0x0b3a5a,.3),4.55,-.1,0,true);
  for(let r=0;r<5;r++)[4.25,4.85].forEach(x=>{const n=1+((rnd()*2)|0);for(let k=0;k<n;k++)bx(sh,.55,.36,.8,mats[(rnd()*6)|0],x,.4+k*.38,-2+r*.9)});
  bx(sh,1.1,.9,.6,M(0xe2e8f0),4.55,.4,2.4);
  const fs=floater(sp,pw,()=>sp.position.x-4.5,()=>0,-.08,60,6);let th=0,om=0;
  anim.push((t,dt)=>{
   /* con lắc: xe đẩy tăng/giảm tốc làm tải đu đưa */
   tr.position.x=2.9+1.9*Math.sin(t*.9);const a=-1.9*.81*Math.sin(t*.9),L=1.5;
   for(let s=0;s<2;s++){const h=dt/2;om+=(-(9.8/L)*Math.sin(th)-(a/L)*Math.cos(th)-1.1*om)*h;th+=om*h}
   pd.rotation.z=th;fs(t,dt)});
  return g;
 }

 /* Cảnh 3: chip bán dẫn */
 function chip(){
  const g=new THREE.Group();
  bx(g,9,.2,9,M(0x0b1b2e,0x0b3a5a,.3),0,-.2,0,true);
  const tm=M(0x38bdf8,0x38bdf8,.6,.2),gold=M(0xfbbf24,0xb45309,.3,.8),pk=new THREE.SphereGeometry(.08,12,12),pm=M(0xffffff,0xffffff,1);
  for(let s=0;s<4;s++){
   const tg=new THREE.Group();tg.rotation.y=s*Math.PI/2;g.add(tg);
   for(let i=0;i<10;i++){
    const off=-1.35+i*.3;
    bx(tg,.12,.06,.5,gold,off,0,1.95);bx(tg,.05,.03,2.1,tm,off,0,3.25);
    if(i%2===0){const m=new THREE.Mesh(pk,pm);m.position.set(off,.1,3);tg.add(m);const ph=(i*.173+s*.31)%1;anim.push(t=>{m.position.z=4.3-((t*.5+ph)%1)*2.1})}
   }
  }
  bx(g,3.4,.5,3.4,M(0x0f172a,0,0,.8),0,0,0,true);bx(g,3,.08,3,M(0x94a3b8,0,0,.9),0,.5,0);
  const dm=M(0x0c4a6e,0x38bdf8,1,.3);bx(g,1.5,.06,1.5,dm,0,.58,0,true);
  const rnd=rng(5);for(let i=0;i<14;i++){const a=rnd()*6.28,r=3.4+rnd()*.9;bx(g,.28,.16,.18,M(0x334155,0,0,.6),Math.cos(a)*r,0,Math.sin(a)*r)}
  anim.push(t=>{dm.emissiveIntensity=.8+.5*Math.sin(t*3)});
  /* dòng nhiệt: hạt bốc lên, nở dần, xoáy nhẹ, nguội từ cam sang xanh */
  const N=240,pa=new Float32Array(N*3),pcol=new Float32Array(N*3),life=new Float32Array(N),mxl=new Float32Array(N),vy=new Float32Array(N),ph=new Float32Array(N);
  const pgeo=new THREE.BufferGeometry();pgeo.setAttribute('position',new THREE.BufferAttribute(pa,3));pgeo.setAttribute('color',new THREE.BufferAttribute(pcol,3));
  const heat=new THREE.Points(pgeo,new THREE.PointsMaterial({size:.16,vertexColors:true,transparent:true,blending:THREE.AdditiveBlending,depthWrite:false}));
  heat.frustumCulled=false;g.add(heat);
  const reset=i=>{pa[i*3]=(Math.random()-.5)*1.5;pa[i*3+1]=.64;pa[i*3+2]=(Math.random()-.5)*1.5;life[i]=0;mxl[i]=2+Math.random()*1.6;vy[i]=.55+Math.random()*.5;ph[i]=Math.random()*6.28};
  for(let i=0;i<N;i++){reset(i);life[i]=Math.random()*mxl[i];pa[i*3+1]+=life[i]*vy[i]*.8}
  anim.push((t,dt)=>{dt=dt||.016;
   for(let i=0;i<N;i++){
    life[i]+=dt;if(life[i]>mxl[i])reset(i);
    const k=life[i]/mxl[i],j=i*3;
    pa[j]+=Math.sin(t*1.8+ph[i]+pa[j+1]*2.6)*.5*dt*(.4+k);
    pa[j+2]+=Math.cos(t*1.5+ph[i]*1.3+pa[j+1]*2.2)*.5*dt*(.4+k);
    pa[j+1]+=vy[i]*dt*(1-.35*k);
    const f=Math.sin(Math.PI*k);pcol[j]=f*(1-.8*k);pcol[j+1]=f*(.55+.25*k);pcol[j+2]=f*(.2+.8*k);
   }
   pgeo.attributes.position.needsUpdate=true;pgeo.attributes.color.needsUpdate=true});
  return g;
 }

 const B=[city,port,chip];
 function setScene(i){
  if(cur){pivot.remove(cur);cur.traverse(o=>{if(o.geometry)o.geometry.dispose();if(o.material)o.material.dispose&&o.material.dispose()})}
  anim=[];waters=[];cur=B[i]();cur.scale.setScalar(.01);born=performance.now();pivot.add(cur);
 }
 window.setFDIScene=setScene;
 window.fdiReset=()=>{ry=.6;rx=.45;dist=15};

 const fit=()=>{const w=cv.clientWidth,h=cv.clientHeight;if(!w||!h)return;R.setSize(w,h,false);cam.aspect=w/h;cam.updateProjectionMatrix()};
 new ResizeObserver(fit).observe(cv);
 new IntersectionObserver(e=>vis=e[0].isIntersecting).observe(cv);
 cv.addEventListener('pointerdown',e=>{mv=0;drag=true;px=e.clientX;py=e.clientY;lastInt=performance.now();cv.style.cursor='grabbing';cv.setPointerCapture(e.pointerId)});
 cv.addEventListener('pointermove',e=>{if(!drag)return;mv+=Math.abs(e.clientX-px)+Math.abs(e.clientY-py);ry+=(e.clientX-px)*.008;rx=Math.max(.1,Math.min(1.3,rx+(e.clientY-py)*.005));px=e.clientX;py=e.clientY;lastInt=performance.now()});
 const up=()=>{drag=false;cv.style.cursor='grab';lastInt=performance.now()};
 cv.addEventListener('pointerup',up);cv.addEventListener('pointercancel',up);
 cv.addEventListener('wheel',e=>{e.preventDefault();dist=Math.max(8,Math.min(22,dist+e.deltaY*.012));lastInt=performance.now()},{passive:false});
 cam.position.set(0,0,dist);
 const rc=new THREE.Raycaster(),v2=new THREE.Vector2();
 cv.addEventListener('click',e=>{
  if(mv>6||!waters.length)return;
  const r=cv.getBoundingClientRect();v2.set((e.clientX-r.left)/r.width*2-1,-((e.clientY-r.top)/r.height)*2+1);rc.setFromCamera(v2,cam);
  const hit=rc.intersectObjects(waters.map(w=>w.mesh))[0];if(!hit)return;
  const w=waters.find(x=>x.mesh===hit.object),p=hit.object.worldToLocal(hit.point.clone());w.ripple(p.x,p.z);play('ripple');
 });
 function frame(now){
  requestAnimationFrame(frame);
  const dt=Math.min(.05,(now-lastF)/1000);lastF=now;
  if(!vis||document.hidden||!cur)return;
  if(!drag&&!reduce&&now-lastInt>1500)ry+=.003;
  pivot.rotation.x=rx;pivot.rotation.y=ry;
  cam.position.z+=(dist-cam.position.z)*.1;
  const k=Math.min(1,(now-born)/600);cur.scale.setScalar(.01+.99*(1-Math.pow(1-k,3)));
  const t=now/1000;tNow=t;waters.forEach(w=>w.update(t));anim.forEach(f=>f(t,dt));
  R.render(sc,cam);
 }
 fit();setScene(modelIdx);requestAnimationFrame(frame);
}

/* ---------- KHỐI THƯ VIỆN 1 ---------- */
const orb=$('#orbit'); let ang=0,vel=0,odrag=false,omoved=0,osx=0,ohover=false,ovis=true,olast=performance.now();
function buildCarousel(){
 orb.querySelectorAll('.oc').forEach(e=>e.remove());
 ITEMS.forEach(it=>{const d=it[lang],b=document.createElement('button');
  b.className='oc';b.dataset.k=it.k;b.setAttribute('aria-label',d.t);
  b.innerHTML=imgTag(it.img,d.t)+`<span>${esc(d.t)}<small>${esc(d.s)}</small></span>`;orb.appendChild(b)});
 layoutOrbit();
}
function layoutOrbit(){
 const w=orb.clientWidth,h=orb.clientHeight,rx=w*.38,ry=h*.26,cs=orb.querySelectorAll('.oc'),n=cs.length;
 cs.forEach((el,i)=>{
  const th=i/n*Math.PI*2+ang,c=Math.cos(th),sn=Math.sin(th),k=(sn+1)/2;
  el.style.transform=`translate(calc(-50% + ${(c*rx).toFixed(1)}px),calc(-50% + ${(sn*ry).toFixed(1)}px)) scale(${(.68+.32*k).toFixed(3)})`;
  el.style.opacity=(.4+.6*k).toFixed(2);
  el.style.filter=`brightness(${(.6+.4*k).toFixed(2)})`;
  el.style.zIndex=Math.round(k*100);
 });
}
function orbitLoop(now){
 const dt=Math.min(now-olast,50);olast=now;
 if(ovis&&!document.hidden){
  if(!odrag){ if(Math.abs(vel)>.0003){ang+=vel;vel*=.94} else if(!ohover&&!reduce)ang+=dt*.00022 }
  layoutOrbit();
 }
 requestAnimationFrame(orbitLoop);
}
new IntersectionObserver(e=>ovis=e[0].isIntersecting).observe(orb);
orb.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse')ohover=true});
orb.addEventListener('pointerleave',e=>{if(e.pointerType==='mouse')ohover=false});
orb.addEventListener('pointerdown',e=>{odrag=true;omoved=0;osx=e.clientX;vel=0;orb.classList.add('drag')});
addEventListener('pointermove',e=>{if(!odrag)return;const dx=e.clientX-osx;osx=e.clientX;omoved+=Math.abs(dx);ang+=dx*.006;vel=dx*.006});
addEventListener('pointerup',()=>{odrag=false;orb.classList.remove('drag')});
orb.addEventListener('click',e=>{const c=e.target.closest('.oc');if(c&&omoved<6)openDetail(c.dataset.k)});
addEventListener('resize',layoutOrbit);

/* ---------- KHỐI THƯ VIỆN 2 ---------- */
const pxEl=$('#px'),PX_ORDER=[[0,3,1,4,2],[2,4,0,3,1],[1,0,4,2,3]],PX_AMP=[-420,320,-220];let pxCols=[];
function buildParallax(){
 pxCols=[...pxEl.querySelectorAll('.px-col')];
 pxCols.forEach((col,ci)=>{col.innerHTML=PX_ORDER[ci].map(i=>{const it=ITEMS[i],d=it[lang];
  return `<button class="pxc" data-k="${it.k}" aria-label="${esc(d.t)}">${imgTag(it.img,d.t)}<span>${esc(d.t)}<small>${esc(d.s)}</small></span></button>`}).join('')});
 pxUpdate();
}
function pxUpdate(){
 if(reduce||!pxCols.length)return;
 const r=pxEl.getBoundingClientRect();if(r.bottom<-300||r.top>innerHeight+300)return;
 const p=(innerHeight-r.top)/(innerHeight+r.height);
 pxCols.forEach((c,i)=>c.style.transform=`translate3d(0,${((p-.5)*PX_AMP[i]).toFixed(1)}px,0)`);
}
pxEl.addEventListener('click',e=>{const c=e.target.closest('.pxc');if(c)openDetail(c.dataset.k)});
addEventListener('resize',pxUpdate);

/* ---------- KHỐI HÌNH ẢNH TƯƠNG TÁC ---------- */
function initHalftone(){
 const cv=$('#halftone'),ctx=cv.getContext('2d'),img=new Image();
 img.crossOrigin='anonymous'; img.src=ITEMS[3].img;
 let W=0,H=0,dpr=1,cell=10,cols=0,rows=0,lum=null,px=0,py=0,rad=0,tr=0,intro=0,vis=false,last=performance.now();
 const cover=(c,w,h)=>{const s=Math.max(w/img.width,h/img.height),iw=img.width*s,ih=img.height*s;c.drawImage(img,(w-iw)/2,(h-ih)/2,iw,ih)};
 function setup(){
  const r=cv.getBoundingClientRect();if(!r.width)return;
  dpr=Math.min(devicePixelRatio||1,2);W=r.width;H=r.height;cv.width=W*dpr;cv.height=H*dpr;
  cell=W<500?7:10;cols=Math.ceil(W/cell);rows=Math.ceil(H/cell);lum=null;
  if(!img.complete||!img.naturalWidth)return;
  try{const o=document.createElement('canvas');o.width=cols;o.height=rows;const oc=o.getContext('2d');cover(oc,cols,rows);
   const d=oc.getImageData(0,0,cols,rows).data;lum=new Float32Array(cols*rows);
   for(let i=0;i<lum.length;i++)lum[i]=(.2126*d[i*4]+.7152*d[i*4+1]+.0722*d[i*4+2])/255;
  }catch(e){lum=null}
 }
 function draw(dt){
  ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,W,H);
  if(intro<1){intro=Math.min(1,intro+dt/3000);px=W*(.12+.76*intro);py=H/2+Math.sin(intro*7)*H*.22;tr=140}
  rad+=(tr-rad)*.14;
  ctx.fillStyle='#38BDF8';
  for(let y=0;y<rows;y++)for(let x=0;x<cols;x++){
   const l=lum?lum[y*cols+x]:.55+.35*Math.sin(x*.3)*Math.cos(y*.3),r=cell*.52*Math.sqrt(l);
   if(r<.5)continue;
   const cx=x*cell+cell/2,cy=y*cell+cell/2,dist=Math.hypot(cx-px,cy-py),fade=dist<rad?Math.max(0,(dist-rad*.6)/(rad*.4)):1;
   ctx.globalAlpha=(.3+.7*l)*fade;ctx.beginPath();ctx.arc(cx,cy,r,0,6.2832);ctx.fill();
  }
  ctx.globalAlpha=1;
  if(rad>2&&img.naturalWidth){
   ctx.save();ctx.beginPath();ctx.arc(px,py,rad,0,6.2832);ctx.clip();cover(ctx,W,H);ctx.restore();
   ctx.strokeStyle='rgba(125,211,252,.7)';ctx.lineWidth=1.5;ctx.beginPath();ctx.arc(px,py,rad,0,6.2832);ctx.stroke();
  }
 }
 function loop(now){const dt=Math.min(now-last,50);last=now;if(vis&&!document.hidden)draw(dt);requestAnimationFrame(loop)}
 const move=e=>{const r=cv.getBoundingClientRect();px=e.clientX-r.left;py=e.clientY-r.top;intro=1;tr=150};
 cv.addEventListener('pointerenter',move);cv.addEventListener('pointermove',move);
 cv.addEventListener('pointerleave',()=>{tr=0});
 cv.addEventListener('pointerdown',move);
 img.addEventListener('load',setup);img.addEventListener('error',()=>{img.removeAttribute('src');lum=null},{once:true});
 new ResizeObserver(setup).observe(cv);
 new IntersectionObserver(e=>{vis=e[0].isIntersecting;if(vis&&intro>=1&&reduce)intro=.5}).observe(cv);
 setup();requestAnimationFrame(loop);
}

/* ---------- NỀN ẢNH VIỆT NAM ---------- */
function initVnBg(){
 const targets=document.querySelectorAll('#topic, #bento, #figures, #model, #parallax');
 if(!targets.length||!('IntersectionObserver' in window))return;
 const active=new Set();
 const io=new IntersectionObserver(es=>{
  es.forEach(en=>{
   if(en.isIntersecting)active.add(en.target);
   else active.delete(en.target);
  });
  document.body.classList.toggle('fdi-dim-bg',active.size>0);
 },{threshold:.2});
 targets.forEach(el=>io.observe(el));
}

/* ---------- KHỐI GIỚI THIỆU ---------- */
function initScrollExpand(){
 const track=$('#se-track'),stage=$('#se-stage'),frame=$('#se-frame'),media=$('#se-media'),
  title=$('#se-title'),scrim=$('#se-scrim'),overlay=$('#se-overlay'),hint=$('#se-hint');
 if(!track)return;
 const C={startWidth:42,startHeight:58,startRadius:24,endRadius:0,mediaZoom:1.35,
  scrollDistance:1.2,holdDistance:.35,smoothing:.1,overlayScrim:.45};
 const clamp=(v,a,b)=>v<a?a:v>b?b:v;
 const smooth=(a,b,x)=>{const t=clamp((x-a)/((b-a)||1e-6),0,1);return t*t*(3-2*t)};
 let cur=0,target=0,stageH=0,raf=0,running=false;

 function apply(p){
  const e=smooth(0,1,p);
  const w=C.startWidth+(100-C.startWidth)*e, h=C.startHeight+(100-C.startHeight)*e;
  const ix=Math.max(0,(100-w)/2), iy=Math.max(0,(100-h)/2);
  const r=C.startRadius+(C.endRadius-C.startRadius)*e;
  frame.style.clipPath=`inset(${iy}% ${ix}% ${iy}% ${ix}% round ${r}px)`;
  media.style.transform=`scale(${C.mediaZoom+(1-C.mediaZoom)*e})`;
  scrim.style.opacity=C.overlayScrim*e;
  const out=smooth(.4,.88,p);
  title.style.opacity=1-out;
  title.style.transform=`translate3d(0,${-28*out}px,0) scale(${1+.06*out})`;
  const gone=smooth(0,.12,p);
  hint.style.opacity=1-gone;
  hint.style.transform=`translate3d(0,${8*gone}px,0)`;
  const inn=smooth(.68,1,p);
  overlay.style.opacity=inn;
  overlay.style.transform=`translate3d(0,${18*(1-inn)}px,0)`;
 }
 function measure(){
  stageH=innerHeight; if(stageH<=0)return;
  track.style.height=stageH*(1+C.scrollDistance+C.holdDistance)+'px';
  stage.style.setProperty('--se-title-size',clamp(innerWidth*.075,20,84)+'px');
 }
 const read=()=>clamp(-track.getBoundingClientRect().top/(stageH*C.scrollDistance),0,1);
 function tick(){
  const k=1-Math.exp(-1/(60*C.smoothing));
  cur+=(target-cur)*k;
  if(Math.abs(target-cur)<.0004){cur=target;running=false}
  apply(cur);
  raf=running?requestAnimationFrame(tick):0;
 }
 function onScroll(){
  target=read();
  if(reduce){cur=target;apply(cur);return}
  if(!running){running=true;if(!raf)raf=requestAnimationFrame(tick)}
 }
 function onResize(){measure();target=read();cur=target;apply(cur)}
 measure();target=read();cur=target;apply(cur);
 addEventListener('scroll',onScroll,{passive:true});
 addEventListener('resize',onResize);
}

/* ---------- TRANG CHỦ ---------- */
function splitHero(){
 const h=$('#h1'); if(!h)return; let i=0;
 [...h.children].forEach(el=>{
  el.innerHTML=el.textContent.trim().split(/\s+/).map(w=>`<span class="hw" style="--i:${i++}">${esc(w)}</span>`).join(' ');
 });
}
function renderChips(){
 const box=$('#heroChips'); if(!box)return;
 box.innerHTML=t('chips').map((c,i)=>`<div class="rise" style="--d:${2.15+i*.12}s"><div class="hc" style="animation-delay:${i*.9}s"><i class="fa-solid ${c[0]}"></i><div><b>${esc(c[1])}</b><small>${esc(c[2])}</small></div></div></div>`).join('');
}
let rotI=0;
function rotTick(){
 const el=$('#rot'); if(!el)return; const a=t('rot');
 el.classList.remove('rin'); void el.offsetWidth; el.textContent=a[rotI++%a.length]; el.classList.add('rin');
}
const heroIn=$('#heroIn'), heroCue=$('#heroCue');
function heroScroll(){
 if(reduce)return; const y=scrollY; if(y>innerHeight*1.5)return;
 const k=Math.min(1,y/(innerHeight*.8));
 heroIn.style.transform=`translate3d(0,${(y*.22).toFixed(1)}px,0) scale(${(1-.05*k).toFixed(3)})`;
 heroIn.style.opacity=(1-k*.9).toFixed(2);
 heroCue.style.opacity=(1-Math.min(1,y/120)).toFixed(2);
}
function initHero(){
 const hero=$('#hero'),cv=$('#heroFx'),ctx=cv.getContext('2d');
 let W=0,H=0,dpr=1,pts=[],vis=true;
 const mk=()=>({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.35,vy:(Math.random()-.5)*.35,r:Math.random()*1.6+.6});
 function size(){
  const r=hero.getBoundingClientRect(); if(!r.width)return;
  W=r.width;H=r.height;dpr=Math.min(devicePixelRatio||1,2);cv.width=W*dpr;cv.height=H*dpr;
  const n=Math.max(24,Math.min(80,Math.round(W*H/16000)));
  pts=Array.from({length:n},mk);
 }
 function draw(){
  ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,W,H);
  for(const p of pts){
   if(!reduce){
    p.vx*=.995;p.vy*=.995;p.x+=p.vx;p.y+=p.vy;
    if(p.x<0)p.x=W;else if(p.x>W)p.x=0;
    if(p.y<0)p.y=H;else if(p.y>H)p.y=0;
   }
  }
  ctx.lineWidth=1;
  for(let i=0;i<pts.length;i++){
   const a=pts[i];
   for(let j=i+1;j<pts.length;j++){
    const b=pts[j],d=Math.hypot(a.x-b.x,a.y-b.y);
    if(d<120){ctx.strokeStyle=`rgba(125,211,252,${((1-d/120)*.22).toFixed(3)})`;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke()}
   }
   ctx.fillStyle='rgba(186,230,253,.75)';ctx.beginPath();ctx.arc(a.x,a.y,a.r,0,6.2832);ctx.fill();
  }
 }
 function loop(){if(vis&&!document.hidden)draw();requestAnimationFrame(loop)}
 new IntersectionObserver(e=>vis=e[0].isIntersecting).observe(hero);
 new ResizeObserver(()=>{size();if(reduce)draw()}).observe(hero);
 setInterval(()=>{if(!document.hidden&&vis)rotTick()},2400);
 size();if(reduce)draw();else requestAnimationFrame(loop);
}

/* ---------- SỰ KIỆN CHUNG ---------- */
document.addEventListener('click',e=>{
 const el=e.target instanceof Element?e.target:e.target&&e.target.parentElement;
 if(!el||typeof el.closest!=='function')return;
 const k=el.closest('#bento [data-k], #acc [data-k]'); if(k)openDetail(k.dataset.k);
 const n=el.closest('[data-n]'); if(n){play('wrap');toast(t('pv')(esc(n.dataset.n)),t('pt'))}
 if(el.closest('[data-kiet]'))openKiet();
 const sb=el.closest('.sb'); if(sb){const p=document.createElement('span');p.className='pulse';sb.appendChild(p);setTimeout(()=>p.remove(),650)}
});
document.addEventListener('pointerenter',e=>{
 if(e.pointerType!=='mouse')return;
 const el=e.target instanceof Element?e.target:e.target&&e.target.parentElement;
 if(el&&typeof el.closest==='function'&&el.closest('button, a, .sb, .oc, .pxc, .acc-i'))play('hover');
},{capture:true,passive:true});
document.addEventListener('keydown',e=>{
 if((e.key==='Enter'||e.key===' ')&&e.target instanceof Element&&e.target.matches('.sb[role=button]')){e.preventDefault();e.target.click()}
});
document.addEventListener('pointermove',e=>{
 const el=e.target instanceof Element?e.target:e.target&&e.target.parentElement;
 const c=el&&typeof el.closest==='function'?el.closest('.card'):null; if(!c)return;
 const r=c.getBoundingClientRect(); c.style.setProperty('--mx',(e.clientX-r.left)+'px'); c.style.setProperty('--my',(e.clientY-r.top)+'px');
});
$('#logo3').onclick=openGroup3;
$('#t2').onclick=openTopic2;
$('#home').onclick=()=>{play('tine');scrollTo({top:0,behavior:'smooth'})};
$('#top').onclick=()=>scrollTo({top:0,behavior:'smooth'});
$('#lang').onclick=()=>{lang=lang==='vi'?'en':'vi';localStorage.setItem('lang',lang);play('tine');closeModal();renderAll()};

/* ---------- CUỘN: thanh tiến độ + hiệu ứng mờ chuyển động nhẹ ---------- */
const wrap=$('#wrap'), seSec=$('#se'); let lastY=scrollY, ticking=false, blurTimer=null;
addEventListener('scroll',()=>{
 if(ticking)return; ticking=true;
 requestAnimationFrame(()=>{
  const y=scrollY, dy=y-lastY; lastY=y;
  const h=document.documentElement.scrollHeight-innerHeight;
  $('#progress').style.width=(h>0?y/h*100:0)+'%';
  pxUpdate();heroScroll();$('#hdr').classList.toggle('sc',y>20);const top=$('#top'); top.classList.toggle('opacity-0',y<600); top.classList.toggle('pointer-events-none',y<600);
  /* bỏ hiệu ứng blur khi đang ở vùng giới thiệu để ảnh luôn nét */
  const sr=seSec.getBoundingClientRect(), inSE=sr.top<innerHeight&&sr.bottom>0;
  if(!reduce&&!inSE&&Math.abs(dy)>25){
   wrap.style.filter=`blur(${Math.min(Math.abs(dy)*.03,2.5).toFixed(2)}px)`;
   clearTimeout(blurTimer); blurTimer=setTimeout(()=>wrap.style.filter='',120);
  }else if(inSE&&wrap.style.filter){wrap.style.filter=''}
  ticking=false;
 });
},{passive:true});

/* ---------- KHỞI TẠO ---------- */
renderAll(); syncSnd(); initVnBg(); initHalftone(); initFDI3D(); initScrollExpand(); initHero(); requestAnimationFrame(orbitLoop);
addEventListener('load',()=>{
 AOS.init({duration:800,once:true,disable:()=>reduce});
 const pre=$('#preloader'); let done=false;
 const hide=()=>{
  if(done)return; done=true;
  if(actx&&actx.state==='running')play('intro'); else play('tine');
  pre.style.opacity=0; pre.style.pointerEvents='none';
  setTimeout(()=>pre.remove(),700);
 };
 ['pointerdown','keydown'].forEach(evt=>{
  window.addEventListener(evt,()=>{
   const c=ensureAudio();
   if(c&&c.state==='running')play('intro');
  },{once:true,passive:true});
 });
 pre.addEventListener('click',hide); setTimeout(hide,1200);
});
</script>
</body>
</html>
