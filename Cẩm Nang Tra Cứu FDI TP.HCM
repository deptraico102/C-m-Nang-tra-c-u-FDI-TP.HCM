 openModal(`<div class="text-center"><div class="w-16 h-16 mx-auto mb-4 rounded-3xl bg-sky-500/20 border border-sky-400/50 flex items-center justify-center text-sky-400 text-3xl"><i class="fa-solid fa-rocket animate-bounce"></i></div>
 <span class="px-3.5 py-1 rounded-full bg-sky-500/20 text-sky-400 text-[10px] mono font-bold border border-sky-400/30">${esc(t('t2b'))}</span>
 <h3 class="text-2xl font-black glow mt-2 mb-4">${esc(t('t2t'))}</h3>
 <div class="p-5 rounded-2xl bg-slate-950/90 border border-sky-500/30 text-sky-300 mono text-sm leading-relaxed">${esc(t('t2d'))}</div></div>`);
}
